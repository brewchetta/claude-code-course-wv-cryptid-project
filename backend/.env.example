# Copy to backend/.env or backend/.env.local (both are read; .env.local wins).
# On Windows, check the file didn't end up as ".env.local.txt".
MSAN_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MSAN_MONGO_DB=msan

# Shared secret for /api/admin/* (moderation). Leave empty to keep those routes off.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MSAN_ADMIN_KEY=

# Contact address sent in the User-Agent of Open-Meteo / USNO requests.
MSAN_CONTACT_EMAIL=

# Reference point and label for the live moon/weather readout (defaults: central WV).
# MSAN_CONDITIONS_LAT=38.66
# MSAN_CONDITIONS_LON=-80.71
# MSAN_CONDITIONS_LABEL=Central WV

# Origins allowed to call the API, as a JSON list. Default is the Vite dev server.
# MSAN_CORS_ORIGINS=["http://localhost:5173"]
